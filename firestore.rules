rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      // Customers can create an order, but only in the expected shape.
      allow create: if request.resource.data.keys().hasAll(
                        ['product', 'unitPrice', 'apartment', 'flatNumber', 'quantity', 'total', 'status', 'createdAt']
                      )
                    && request.resource.data.apartment in ["Navin's", "Casa Grande"]
                    && request.resource.data.flatNumber is string
                    && request.resource.data.flatNumber.size() > 0
                    && request.resource.data.quantity is int
                    && request.resource.data.quantity >= 1
                    && request.resource.data.quantity <= 5
                    && request.resource.data.status == 'open';

      // Only the signed-in admin can read the order list.
      allow read: if request.auth != null;

      // Only the signed-in admin can update: either flip status/closedAt,
      // or edit the order's own contents (validated the same way as create).
      allow update: if request.auth != null
                    && (
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedAt'])
                      || (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['apartment', 'flatNumber', 'quantity', 'total'])
                        && request.resource.data.apartment in ["Navin's", "Casa Grande"]
                        && request.resource.data.flatNumber is string
                        && request.resource.data.flatNumber.size() > 0
                        && request.resource.data.quantity is int
                        && request.resource.data.quantity >= 1
                        && request.resource.data.quantity <= 5
                      )
                    );

      // Only the signed-in admin can delete an order.
      allow delete: if request.auth != null;
    }

    match /config/product {
      // Anyone can read the current product name/price (shown on the order form).
      allow read: if true;

      // Only the signed-in admin can change it, and only to a valid shape.
      allow write: if request.auth != null
                   && request.resource.data.keys().hasAll(['name', 'price'])
                   && request.resource.data.name is string
                   && request.resource.data.name.size() > 0
                   && request.resource.data.price is number
                   && request.resource.data.price > 0;
    }
  }
}
